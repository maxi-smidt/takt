    "test": "vitest run",
    "test:fleet": "vitest run src/fleet/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.29.0",
    "nosleep.js": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  }
