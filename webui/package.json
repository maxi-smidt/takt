{
  "name": "takt-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fleet": "vite --config vite.fleet.config.js",
    "dev:ui": "vite --config vite.ui.config.js",
    "build": "vite build",
    "build:fleet": "vite build --config vite.fleet.config.js",
    "check": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/fleet/maintenanceActions.test.js'",
    "test:fleet": "vitest run src/fleet/*.test.ts src/fleet/services/*.test.ts --exclude 'src/fleet/maintenanceActions.test.js' && node --test src/fleet/maintenanceActions.test.js"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "lucide-react": "^1.29.0",
    "nosleep.js": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  }
}
