{
  "name": "takt-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fleet": "vite --config vite.fleet.config.js",
    "build": "vite build",
    "build:fleet": "vite build --config vite.fleet.config.js",
    "check": "eslint src",
