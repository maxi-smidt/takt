TAKT_REGISTRY_ADMIN_PASSWORD=replace-with-a-long-random-password
TAKT_REGISTRY_ADMIN_USERNAME=replace-with-an-explicit-first-admin-username
# Every image embeds its own verified Raspberry Pi package, so `latest` and
# the offered release always match. Pin to a fixed version (or version@digest)
# instead of `latest` for auditable deployments, e.g.:
# TAKT_REGISTRY_IMAGE=ghcr.io/maxi-smidt/takt-registry:0.3.0
TAKT_REGISTRY_IMAGE=ghcr.io/maxi-smidt/takt-registry:latest
TAKT_REGISTRY_PULL_POLICY=always
TAKT_REGISTRY_DATA_PATH=/mnt/user/appdata/takt/registry-data
TAKT_REGISTRY_PORT=8090
TAKT_REGISTRY_BIND_ADDRESS=0.0.0.0
TAKT_REGISTRY_SECURE_COOKIES=false
